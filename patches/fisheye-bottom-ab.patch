+@pytest.mark.parametrize("validation", [False, True])
+def test_bottom_requires_separate_left_and_right_positions(validation):
+    from stereo_calibration.guidance import achieved
+
+    prefix = "check-" if validation else ""
+    goals = VALIDATION_GOALS if validation else TRAINING_GOALS
+    keys = {g.key for g in goals}
+    assert prefix + "bottom" not in keys
+    assert {prefix + "bottom-a", prefix + "bottom-b"} <= keys
+    pose = dict(x=0.4, y=0.8, scale=0.3, skew_x=0, skew_y=0,
+                roll=0, tilt_x=0, tilt_y=0)
+    a, b = prefix + "bottom-a", prefix + "bottom-b"
+    assert set(achieved(pose, None, validation=validation)) == {a}
+    assert set(achieved(dict(pose, x=0.6), None, validation=validation)) == {b}
+    assert not {a, b}.intersection(achieved(dict(pose, x=0.5), None, validation=validation))
+    # Sweep the region to catch accidental overlap, not just the goal centres.
+    for x in np.linspace(0.2, 0.8, 121):
+        assert not {a, b} <= set(achieved(dict(pose, x=x), None, validation=validation))
+    if validation:
+        assert capture_ready(dict(pose, x=0.6), [pose], pose, {a}, None, validation=True)
+
+
+def test_training_cannot_finish_with_only_one_bottom_point(tmp_path, monkeypatch):
+    from stereo_calibration.config import BoardConfig, CameraConfig
+    from stereo_calibration.controller import Controller
+    from stereo_calibration.guidance import current_goal_keys
+
+    controller = Controller(BoardConfig(), CameraConfig(), output=tmp_path)
+    try:
+        controller.signatures = [None] * 20
+        controller.done_goals = {g.key for g in TRAINING_GOALS} - {"bottom-b"}
+        controller.model = object()  # A provisional fit already exists.
+        fits = []
+        monkeypatch.setattr(controller, "start_fit", lambda *, final: fits.append(final))
+        assert controller.next_goal.key == "bottom-b"
+        controller.after_capture()
+        assert fits == []
+        controller.done_goals.add("bottom-b")
+        controller.after_capture()
+        assert fits == [True]
+        assert current_goal_keys(["bottom", "tilt-bottom"]) == {
+            "bottom-a", "bottom-b", "tilt-bottom"
+        }
+    finally:
+        controller.close()
+
