<launch>
    <!--
    ╔══════════════════════════════════════════════════════════════════╗
    ║          【初学者速读】start_robot_all.launch 是什么？           ║
    ╚══════════════════════════════════════════════════════════════════╝

    这是整个机器人系统的"总开关"启动文件。
    roslaunch 运行它之后，会依次把所有子模块全部拉起来。

    ┌─────────────────── 启动了哪些东西？───────────────────────────┐
    │                                                                │
    │  1. 双臂控制节点（piper_dual_robot.launch）                   │
    │     通过 CAN 总线（can_left / can_right）和真实机械臂通信     │
    │     CAN = 工业现场总线，机器人关节用它收发指令               │
    │                                                                │
    │  2. 第三条从臂 opp（可选，默认关闭）                          │
    │     默认由 opp_can_port 是否非空自动决定是否启动              │
    │     也兼容 enable_opp_slave 显式覆盖                          │
    │     开启后会多启动一条"对置从臂"和可选的眼动追踪桥接          │
    │                                                                │
    │  3. 摄像头（camera_slot.launch × 最多4路）                    │
    │     左腕相机  realsense_left   (USB端口 2-2.2.1.4)            │
    │     右腕相机  realsense_right  (USB端口 2-2.2.1.2)            │
    │     顶部相机  realsense_top    (USB端口 2-2.2.1.3)            │
    │     额外相机  extra_1          (默认关闭)                      │
    │     ⚠ 每台摄像头错开几秒启动（0/6/12/18秒）                 │
    │       原因：多路 RealSense 同时初始化会抢 USB 带宽导致崩溃    │
    │                                                                │
    │  4. 鱼眼相机（可选，默认关闭）                                │
    │     enable_fisheye=true 时替代腕部相机                        │
    │                                                                │
    │  5. 手眼标定 TF 发布（cam_calibration/publish.launch）         │
    │     把相机坐标系和机械臂末端坐标系的相对关系发布出去          │
    │     AI 模型/可视化工具 需要它才能知道"相机装在哪里"           │
    │                                                                │
    │  6. RViz 可视化界面                                            │
    │     enable_rviz=true → 自动打开3D可视化窗口                   │
    │     会根据是否开启鱼眼/摄像头数量动态选择配置文件             │
    └────────────────────────────────────────────────────────────────┘

    ┌─────────────────── 关键概念速查 ──────────────────────────────┐
    │  <arg name="xxx" default="yyy" />                              │
    │    = 定义参数，默认值 yyy，启动时可用 xxx:=新值 覆盖          │
    │    示例: roslaunch ... enable_cameras:=false                   │
    │                                                                │
    │  <group if="$(arg enable_xxx)">                                │
    │    = 只有当 enable_xxx=true 时才执行这段内容                   │
    │                                                                │
    │  <include file="..." />                                        │
    │    = 把另一个 launch 文件嵌套进来（相当于"调用子程序"）        │
    │                                                                │
    │  $(find package_name)                                          │
    │    = 自动找到 ROS 包的安装路径（不用写绝对路径）               │
    └────────────────────────────────────────────────────────────────┘

    ┌─────────────────── 启动顺序示意 ──────────────────────────────┐
    │  roslaunch robot_setup start_robot_all.launch                  │
    │      │                                                         │
    │      ├─► [立刻] 双臂控制节点 (CAN 通信)                       │
    │      ├─► [立刻] 左腕相机  (延迟 0s)                           │
    │      ├─► [+6s ] 右腕相机  (延迟 6s，错开USB初始化)            │
    │      ├─► [+12s] 顶部相机  (延迟 12s)                          │
    │      ├─► [立刻] 手眼TF发布                                     │
    │      └─► [立刻] RViz 可视化                                    │
    └────────────────────────────────────────────────────────────────┘

    顶部相机后端选择逻辑（安全默认）：
      默认使用 realsense；
      只有显式设置 camera_top_backend:=usb 才会走 usb_cam。
      （避免误把 RealSense 启动成 USB 节点）
    -->

    <!-- Arguments for CAN ports -->
    <arg name="ranger_can_port" default="can0" />
    <arg name="left_can_port" default="can_sl" />
    <arg name="right_can_port" default="can_sr" />

    <!-- Arguments for dual-arm control -->
    <arg name="enable_dual_arm" default="true" />
    <!-- robot_control_mode:
         - teleop: no arbiter, mux defaults to /teleop/* with optional manual switch to /robot/*/vla_joint_cmd
         - intervention: arbiter + robot_cmd pipeline -->
    <arg name="robot_control_mode" default="intervention" />
    <arg name="piper_ctrl_mode" default="mit" />
    <arg name="enable_follower_gravity" default="true" />
    <arg name="follower_gravity_config" default="$(find piper_ctrl)/config/follower_gravity.yaml" />
    <arg name="enable_arbiter_keyboard" default="false" />
    <arg name="action_arbiter_controlled_arm" default="both" />
    <arg name="action_arbiter_initial_mode" default="POLICY" />
    <arg name="action_arbiter_rate_hz" default="200.0" />
    <arg name="action_arbiter_blend_sec" default="0.8" />
    <arg name="action_arbiter_human_to_policy_blend_sec" default="$(arg action_arbiter_blend_sec)" />
    <arg name="action_arbiter_sync_to_human_blend_sec" default="$(arg action_arbiter_blend_sec)" />
    <arg name="action_arbiter_source_timeout_sec" default="0.30" />
    <arg name="action_arbiter_allow_fallback" default="false" />
    <arg name="action_arbiter_hold_last_on_timeout" default="true" />
    <arg name="action_arbiter_publish_follow_flag" default="true" />
    <arg name="action_arbiter_follow_flag_sync_value" default="true" />
    <arg name="action_arbiter_prepare_human_joint_tol_rad" default="0.08" />
    <arg name="action_arbiter_prepare_human_gripper_tol" default="0.008" />
    <arg name="action_arbiter_prepare_human_ready_hold_sec" default="0.08" />
    <arg name="action_arbiter_prepare_human_max_sec" default="0.60" />
    <arg name="action_arbiter_prepare_human_hold_reference" default="true" />
    <arg name="action_arbiter_prepare_human_reference_source" default="robot_state" />
    <arg name="action_arbiter_left_robot_state_topic" default="/robot/arm_left/joint_states_single" />
    <arg name="action_arbiter_right_robot_state_topic" default="/robot/arm_right/joint_states_single" />
    <arg name="action_arbiter_prepare_policy_min_sec" default="0.05" />
    <arg name="action_arbiter_prepare_policy_bias_tau_sec" default="0.25" />
    <arg name="action_arbiter_prepare_policy_enter_tol_rad" default="0.012" />
    <arg name="action_arbiter_prepare_policy_max_sec" default="0.80" />
    <arg name="action_arbiter_prepare_policy_include_gripper_bias" default="false" />
    <arg name="action_arbiter_prepare_policy_hold_gripper" default="true" />
    <arg name="action_arbiter_prepare_policy_gripper_handover_sec" default="0.25" />
    <arg name="action_arbiter_gripper_handover_sec" default="0.20" />
    <arg name="opp_can_port" default="" />
    <arg name="enable_opp_slave" default="$(eval 'true' if str(arg('opp_can_port')).strip() else 'false')" />
    <arg name="opp_teleop_topic" default="/teleop/arm_opp/joint_states_single" />
    <arg name="opp_robot_cmd_topic" default="/robot/arm_opp/joint_cmd_mux" />
    <arg name="opp_policy_topic" default="/robot/arm_opp/vla_joint_cmd" />
    <arg name="auto_enable" default="true" />
    <arg name="opp_gripper_cmd_limit_enable" default="false" />
    <arg name="opp_gripper_cmd_deadband_raw" default="0" />
    <arg name="enable_opp_gaze" default="false" />
    <arg name="opp_gaze_config" default="/workspace/catkin_ws/EyeTrax/gaze_teleop_point_csv_ros.yaml" />
    <arg name="opp_gaze_python" default="python3" />
    <!-- Legacy args (kept for backward compatibility). -->
    <arg name="gripper_val_mutiple" default="2" />
    <arg name="girpper_exist" default="true" />
    <!-- Robot-side gripper mapping/shaping (applies to left+right slave arms). -->
    <arg name="robot_gripper_open_scale" default="1.0" />
    <arg name="left_gripper_val_mutiple" default="$(arg robot_gripper_open_scale)" />
    <arg name="right_gripper_val_mutiple" default="$(arg robot_gripper_open_scale)" />
    <arg name="gripper_cmd_limit_enable" default="true" />
    <arg name="gripper_cmd_min_raw" default="0" />
    <arg name="gripper_cmd_max_raw" default="80000" />
    <arg name="gripper_cmd_deadband_raw" default="200" />

    <!-- Arguments for cameras -->
    <arg name="enable_cameras" default="true" />
    <!-- Keep wrist cameras enabled while allowing an externally managed Top
         camera (for example the D405/librealsense-2.55 overlay) to own the
         canonical Top topics.  RViz still uses camera_top_name below. -->
    <arg name="camera_top_enable" default="true" />
    <!-- Resolution args -->
    <!-- Priority: per-camera (camera_*_width/height) > backend-global > built-in defaults. -->
    <!-- Global overrides (optional): camera_width/height applies to both RS and USB. -->
    <!-- Backend-global overrides (optional): camera_rs_color_* / camera_usb_image_*. -->
    <arg name="camera_width" default="" />
    <arg name="camera_height" default="" />
    <arg name="camera_rs_color_width" default="$(arg camera_width)" />
    <arg name="camera_rs_color_height" default="$(arg camera_height)" />
    <arg name="camera_usb_image_width" default="$(arg camera_width)" />
    <arg name="camera_usb_image_height" default="$(arg camera_height)" />
    <arg name="camera_usb_driver_impl" default="custom" />
    <arg name="camera_usb_color_format" default="yuv422p" />
    <arg name="camera_left_width" default="" />
    <arg name="camera_left_height" default="" />
    <arg name="camera_right_width" default="" />
    <arg name="camera_right_height" default="" />
    <arg name="camera_top_width" default="" />
    <arg name="camera_top_height" default="" />
    <arg name="camera_extra_1_width" default="" />
    <arg name="camera_extra_1_height" default="" />

    <arg name="camera_left_name" default="realsense_left" />
    <arg name="camera_left_backend" default="realsense" />
    <arg name="camera_left_serial_no" default="" />
    <arg name="camera_left_usb_port" default="" />
    <arg name="camera_left_frame_id" default="realsense_left_color_optical_frame" />
    <arg name="camera_left_usb_video_device" default="/dev/video0" />
    <arg name="camera_left_usb_image_width" default="$(eval arg('camera_left_width') if str(arg('camera_left_width')).strip() else (arg('camera_usb_image_width') if str(arg('camera_usb_image_width')).strip() else '1280'))" />
    <arg name="camera_left_usb_image_height" default="$(eval arg('camera_left_height') if str(arg('camera_left_height')).strip() else (arg('camera_usb_image_height') if str(arg('camera_usb_image_height')).strip() else '720'))" />
    <arg name="camera_left_usb_fps" default="30" />
    <arg name="camera_left_usb_pixel_format" default="mjpeg" />
    <!-- DECXIN wrist cameras sustain 30Hz with usb_cam; the OpenCV-based custom driver halves FPS. -->
    <arg name="camera_left_usb_driver_impl" default="usb_cam" />
    <arg name="camera_left_usb_color_format" default="yuv422p" />
    <arg name="camera_left_usb_io_method" default="mmap" />
    <arg name="camera_left_usb_jpeg_quality" default="85" />
    <arg name="camera_left_rs_color_width" default="$(eval arg('camera_left_width') if str(arg('camera_left_width')).strip() else (arg('camera_rs_color_width') if str(arg('camera_rs_color_width')).strip() else '640'))" />
    <arg name="camera_left_rs_color_height" default="$(eval arg('camera_left_height') if str(arg('camera_left_height')).strip() else (arg('camera_rs_color_height') if str(arg('camera_rs_color_height')).strip() else '480'))" />
    <arg name="camera_left_rs_color_fps" default="30" />
    <arg name="camera_left_rs_enable_depth" default="false" />
    <arg name="camera_left_rs_enable_infra1" default="true" />
    <arg name="camera_left_rs_enable_infra2" default="false" />
    <arg name="camera_left_rs_enable_pointcloud" default="false" />
    <arg name="camera_left_rs_align_depth" default="false" />

    <arg name="camera_right_name" default="realsense_right" />
    <arg name="camera_right_backend" default="realsense" />
    <arg name="camera_right_serial_no" default="" />
    <arg name="camera_right_usb_port" default="" />
    <arg name="camera_right_frame_id" default="realsense_right_color_optical_frame" />
    <arg name="camera_right_usb_video_device" default="/dev/video0" />
    <arg name="camera_right_usb_image_width" default="$(eval arg('camera_right_width') if str(arg('camera_right_width')).strip() else (arg('camera_usb_image_width') if str(arg('camera_usb_image_width')).strip() else '1280'))" />
    <arg name="camera_right_usb_image_height" default="$(eval arg('camera_right_height') if str(arg('camera_right_height')).strip() else (arg('camera_usb_image_height') if str(arg('camera_usb_image_height')).strip() else '720'))" />
    <arg name="camera_right_usb_fps" default="30" />
    <arg name="camera_right_usb_pixel_format" default="mjpeg" />
    <arg name="camera_right_usb_driver_impl" default="usb_cam" />
    <arg name="camera_right_usb_color_format" default="yuv422p" />
    <arg name="camera_right_usb_io_method" default="mmap" />
    <arg name="camera_right_usb_jpeg_quality" default="85" />
    <arg name="camera_right_rs_color_width" default="$(eval arg('camera_right_width') if str(arg('camera_right_width')).strip() else (arg('camera_rs_color_width') if str(arg('camera_rs_color_width')).strip() else '640'))" />
    <arg name="camera_right_rs_color_height" default="$(eval arg('camera_right_height') if str(arg('camera_right_height')).strip() else (arg('camera_rs_color_height') if str(arg('camera_rs_color_height')).strip() else '480'))" />
    <arg name="camera_right_rs_color_fps" default="30" />
    <arg name="camera_right_rs_enable_depth" default="false" />
    <arg name="camera_right_rs_enable_infra1" default="true" />
    <arg name="camera_right_rs_enable_infra2" default="false" />
    <arg name="camera_right_rs_enable_pointcloud" default="false" />
    <arg name="camera_right_rs_align_depth" default="false" />

    <!-- USB auto-fallback is disabled by default; explicit backend:=usb is required. -->
    <arg name="camera_allow_auto_usb_fallback" default="false" />

    <arg name="camera_top_name" default="top_cam" />
    <arg name="camera_top_serial_no" default="" />
    <arg name="camera_top_usb_port" default="" />
    <!-- Top camera backend selection -->
    <!-- Safety default: keep realsense unless backend:=usb is explicitly set. -->
    <arg name="usb_top_port_markers" default="1-2.1" />
    <arg name="camera_top_allow_auto_usb_fallback" default="$(arg camera_allow_auto_usb_fallback)" />
    <arg name="camera_top_backend" default="realsense" />
    <arg name="top_usb_video_device" default="/dev/video0" />
    <arg name="top_usb_image_width" default="$(eval arg('camera_top_width') if str(arg('camera_top_width')).strip() else (arg('camera_usb_image_width') if str(arg('camera_usb_image_width')).strip() else '1280'))" />
    <arg name="top_usb_image_height" default="$(eval arg('camera_top_height') if str(arg('camera_top_height')).strip() else (arg('camera_usb_image_height') if str(arg('camera_usb_image_height')).strip() else '720'))" />
    <arg name="top_usb_fps" default="30" />
    <arg name="top_usb_pixel_format" default="mjpeg" />
    <arg name="top_usb_driver_impl" default="$(arg camera_usb_driver_impl)" />
    <arg name="top_usb_color_format" default="$(arg camera_usb_color_format)" />
    <arg name="top_usb_io_method" default="mmap" />
    <arg name="top_usb_jpeg_quality" default="85" />
    <!-- Top USB camera defaults are intentionally conservative for the ANYKA device:
         keep the host-side format, wait briefly after startup, and reject non-MJPG opens. -->
    <arg name="top_usb_preconfigure_v4l2" default="false" />
    <arg name="top_usb_configure_capture_properties" default="false" />
    <arg name="top_usb_startup_open_delay_sec" default="2.0" />
    <arg name="top_usb_enforce_actual_resolution" default="true" />
    <arg name="top_usb_enforce_actual_pixel_format" default="true" />
    <arg name="top_usb_startup_verify_frame_count" default="0" />
    <arg name="top_usb_startup_min_read_fps_ratio" default="0.0" />
    <arg name="top_usb_frame_id" default="top_cam_color_optical_frame" />
    <arg name="camera_top_rs_color_width" default="$(eval arg('camera_top_width') if str(arg('camera_top_width')).strip() else (arg('camera_rs_color_width') if str(arg('camera_rs_color_width')).strip() else '848'))" />
    <arg name="camera_top_rs_color_height" default="$(eval arg('camera_top_height') if str(arg('camera_top_height')).strip() else (arg('camera_rs_color_height') if str(arg('camera_rs_color_height')).strip() else '480'))" />
    <arg name="camera_top_rs_color_fps" default="30" />
    <arg name="camera_top_rs_enable_depth" default="false" />
    <arg name="camera_top_rs_enable_infra1" default="false" />
    <arg name="camera_top_rs_enable_infra2" default="false" />
    <arg name="camera_top_rs_enable_pointcloud" default="false" />
    <arg name="camera_top_rs_align_depth" default="false" />

    <arg name="camera_extra_1_enable" default="false" />
    <arg name="camera_extra_1_name" default="realsense_extra_1" />
    <arg name="camera_extra_1_backend" default="realsense" />
    <arg name="camera_extra_1_serial_no" default="" />
    <arg name="camera_extra_1_usb_port" default="" />
    <arg name="camera_extra_1_usb_port_markers" default="$(arg usb_top_port_markers)" />
    <arg name="camera_extra_1_allow_auto_usb_fallback" default="$(arg camera_allow_auto_usb_fallback)" />
    <arg name="camera_extra_1_frame_id" default="$(eval arg('camera_extra_1_name') + '_color_optical_frame')" />
    <arg name="camera_extra_1_usb_video_device" default="/dev/video0" />
    <arg name="camera_extra_1_usb_image_width" default="$(eval arg('camera_extra_1_width') if str(arg('camera_extra_1_width')).strip() else (arg('camera_usb_image_width') if str(arg('camera_usb_image_width')).strip() else '1280'))" />
    <arg name="camera_extra_1_usb_image_height" default="$(eval arg('camera_extra_1_height') if str(arg('camera_extra_1_height')).strip() else (arg('camera_usb_image_height') if str(arg('camera_usb_image_height')).strip() else '720'))" />
    <arg name="camera_extra_1_usb_fps" default="30" />
    <arg name="camera_extra_1_usb_pixel_format" default="mjpeg" />
    <arg name="camera_extra_1_usb_io_method" default="mmap" />
    <arg name="camera_extra_1_usb_jpeg_quality" default="85" />
    <arg name="camera_extra_1_rs_color_width" default="$(eval arg('camera_extra_1_width') if str(arg('camera_extra_1_width')).strip() else (arg('camera_rs_color_width') if str(arg('camera_rs_color_width')).strip() else '640'))" />
    <arg name="camera_extra_1_rs_color_height" default="$(eval arg('camera_extra_1_height') if str(arg('camera_extra_1_height')).strip() else (arg('camera_rs_color_height') if str(arg('camera_rs_color_height')).strip() else '480'))" />
    <arg name="camera_extra_1_rs_color_fps" default="30" />
    <arg name="camera_extra_1_rs_enable_depth" default="false" />
    <arg name="camera_extra_1_rs_enable_infra1" default="false" />
    <arg name="camera_extra_1_rs_enable_infra2" default="false" />
    <arg name="camera_extra_1_rs_enable_pointcloud" default="false" />
    <arg name="camera_extra_1_rs_align_depth" default="false" />

    <!-- Stagger RealSense startup to reduce USB init races -->
    <arg name="realsense_delay_exec" default="$(find robot_setup)/scripts/delay_exec.sh" />
    <arg name="left_realsense_start_delay_sec" default="0.0" />
    <arg name="right_realsense_start_delay_sec" default="6.0" />
    <arg name="top_realsense_start_delay_sec" default="12.0" />
    <arg name="camera_extra_1_realsense_start_delay_sec" default="18.0" />
    <arg name="realsense_initial_reset" default="false" />
    <arg name="realsense_log_level" default="ERROR" />
    <arg name="left_realsense_launch_prefix" default="$(eval arg('realsense_delay_exec') + ' ' + str(arg('left_realsense_start_delay_sec')) if float(arg('left_realsense_start_delay_sec')) > 0.0 else '')" />
    <arg name="right_realsense_launch_prefix" default="$(eval arg('realsense_delay_exec') + ' ' + str(arg('right_realsense_start_delay_sec')) if float(arg('right_realsense_start_delay_sec')) > 0.0 else '')" />
    <arg name="top_realsense_launch_prefix" default="$(eval arg('realsense_delay_exec') + ' ' + str(arg('top_realsense_start_delay_sec')) if float(arg('top_realsense_start_delay_sec')) > 0.0 else '')" />
    <arg name="camera_extra_1_realsense_launch_prefix" default="$(eval arg('realsense_delay_exec') + ' ' + str(arg('camera_extra_1_realsense_start_delay_sec')) if float(arg('camera_extra_1_realsense_start_delay_sec')) > 0.0 else '')" />
    <!-- Optional startup zero via command topics (no mode switch, no hardware zero-point write). -->
    <arg name="enable_auto_zero_on_start" default="false" />
    <arg name="auto_zero_delay_sec" default="3.0" />
    <arg name="auto_zero_duration_sec" default="5.0" />
    <arg name="auto_zero_rate" default="50.0" />
    <arg name="auto_zero_wait_timeout_sec" default="10.0" />
    <arg name="auto_zero_settle_enable" default="true" />
    <arg name="auto_zero_settle_iters" default="12" />
    <arg name="auto_zero_settle_tol_rad" default="0.01" />
    <arg name="auto_zero_settle_gain" default="0.9" />
    <arg name="auto_zero_settle_max_step_rad" default="0.03" />
    <arg name="auto_zero_settle_sample_sec" default="0.15" />
    <arg name="auto_zero_settle_hold_sec" default="0.8" />
    <arg name="auto_zero_settle_include_gripper" default="false" />
    <arg name="auto_zero_launch_prefix" default="$(eval arg('realsense_delay_exec') + ' ' + str(arg('auto_zero_delay_sec')) if float(arg('auto_zero_delay_sec')) > 0.0 else '')" />
    <arg name="enable_camera_preflight_check" default="true" />
    <arg name="camera_preflight_strict" default="true" />
    <arg name="camera_preflight_check_video_occupancy" default="true" />
    <arg name="camera_preflight_auto_cleanup_conflicts" default="false" />
    <arg name="camera_preflight_auto_cleanup_wait_sec" default="1.0" />
    <arg name="enable_rviz" default="true" />
    <arg name="use_default_rviz" default="true" />
    <arg name="rviz_image_transport" default="compressed" />
    <arg name="enable_handeye_tf" default="true" />

    <arg name="enable_fisheye" default="false" />
    <arg name="fisheye_ns" default="fisheye" />
    <arg name="fisheye_left_dev"  default="/dev/fisheye_left" />
    <arg name="fisheye_right_dev" default="/dev/fisheye_right" />
    <arg name="fisheye_top_dev"   default="/dev/wide_top" />
    <arg name="fisheye_mid_dev"   default="/dev/wide_mid" />
    <arg name="robot_description_file" default="$(find piper_description)/urdf/piper_description.urdf" />


    <!-- Setup robot_description for joint_state_publisher_gui if needed -->
    <param name="robot_description" textfile="$(arg robot_description_file)" />

    <!-- Launch dual-arm control node -->
    <!-- Note: Parameters (can_port, topic_prefix, remap) are configured in piper_dual.yaml -->
    <group if="$(arg enable_dual_arm)">
        <include file="$(find piper_ctrl)/launch/piper_dual_robot.launch">
            <arg name="left_can_port" value="$(arg left_can_port)" />
            <arg name="right_can_port" value="$(arg right_can_port)" />
            <arg name="auto_enable" value="$(arg auto_enable)" />
            <arg name="robot_control_mode" value="$(arg robot_control_mode)" />
            <arg name="piper_ctrl_mode" value="$(arg piper_ctrl_mode)" />
            <arg name="enable_follower_gravity" value="$(arg enable_follower_gravity)" />
            <arg name="follower_gravity_config" value="$(arg follower_gravity_config)" />
            <arg name="enable_arbiter_keyboard" value="$(arg enable_arbiter_keyboard)" />
            <arg name="action_arbiter_controlled_arm" value="$(arg action_arbiter_controlled_arm)" />
            <arg name="action_arbiter_initial_mode" value="$(arg action_arbiter_initial_mode)" />
            <arg name="action_arbiter_rate_hz" value="$(arg action_arbiter_rate_hz)" />
            <arg name="action_arbiter_blend_sec" value="$(arg action_arbiter_blend_sec)" />
            <arg name="action_arbiter_human_to_policy_blend_sec" value="$(arg action_arbiter_human_to_policy_blend_sec)" />
            <arg name="action_arbiter_sync_to_human_blend_sec" value="$(arg action_arbiter_sync_to_human_blend_sec)" />
            <arg name="action_arbiter_source_timeout_sec" value="$(arg action_arbiter_source_timeout_sec)" />
            <arg name="action_arbiter_allow_fallback" value="$(arg action_arbiter_allow_fallback)" />
            <arg name="action_arbiter_hold_last_on_timeout" value="$(arg action_arbiter_hold_last_on_timeout)" />
            <arg name="action_arbiter_publish_follow_flag" value="$(arg action_arbiter_publish_follow_flag)" />
            <arg name="action_arbiter_follow_flag_sync_value" value="$(arg action_arbiter_follow_flag_sync_value)" />
            <arg name="action_arbiter_prepare_human_joint_tol_rad" value="$(arg action_arbiter_prepare_human_joint_tol_rad)" />
            <arg name="action_arbiter_prepare_human_gripper_tol" value="$(arg action_arbiter_prepare_human_gripper_tol)" />
            <arg name="action_arbiter_prepare_human_ready_hold_sec" value="$(arg action_arbiter_prepare_human_ready_hold_sec)" />
            <arg name="action_arbiter_prepare_human_max_sec" value="$(arg action_arbiter_prepare_human_max_sec)" />
            <arg name="action_arbiter_prepare_human_hold_reference" value="$(arg action_arbiter_prepare_human_hold_reference)" />
            <arg name="action_arbiter_prepare_human_reference_source" value="$(arg action_arbiter_prepare_human_reference_source)" />
            <arg name="action_arbiter_left_robot_state_topic" value="$(arg action_arbiter_left_robot_state_topic)" />
            <arg name="action_arbiter_right_robot_state_topic" value="$(arg action_arbiter_right_robot_state_topic)" />
            <arg name="action_arbiter_prepare_policy_min_sec" value="$(arg action_arbiter_prepare_policy_min_sec)" />
            <arg name="action_arbiter_prepare_policy_bias_tau_sec" value="$(arg action_arbiter_prepare_policy_bias_tau_sec)" />
            <arg name="action_arbiter_prepare_policy_enter_tol_rad" value="$(arg action_arbiter_prepare_policy_enter_tol_rad)" />
            <arg name="action_arbiter_prepare_policy_max_sec" value="$(arg action_arbiter_prepare_policy_max_sec)" />
            <arg name="action_arbiter_prepare_policy_include_gripper_bias" value="$(arg action_arbiter_prepare_policy_include_gripper_bias)" />
            <arg name="action_arbiter_prepare_policy_hold_gripper" value="$(arg action_arbiter_prepare_policy_hold_gripper)" />
            <arg name="action_arbiter_prepare_policy_gripper_handover_sec" value="$(arg action_arbiter_prepare_policy_gripper_handover_sec)" />
            <arg name="action_arbiter_gripper_handover_sec" value="$(arg action_arbiter_gripper_handover_sec)" />
            <arg name="robot_gripper_open_scale" value="$(arg robot_gripper_open_scale)" />
            <arg name="left_gripper_val_mutiple" value="$(arg left_gripper_val_mutiple)" />
            <arg name="right_gripper_val_mutiple" value="$(arg right_gripper_val_mutiple)" />
            <arg name="gripper_cmd_limit_enable" value="$(arg gripper_cmd_limit_enable)" />
            <arg name="gripper_cmd_min_raw" value="$(arg gripper_cmd_min_raw)" />
            <arg name="gripper_cmd_max_raw" value="$(arg gripper_cmd_max_raw)" />
            <arg name="gripper_cmd_deadband_raw" value="$(arg gripper_cmd_deadband_raw)" />
        </include>
    </group>
    <group if="$(eval arg('enable_dual_arm') and arg('enable_auto_zero_on_start'))">
        <node
            pkg="robot_setup"
            type="startup_zero_via_topic.py"
            name="startup_zero_via_topic"
            launch-prefix="$(arg auto_zero_launch_prefix)"
            output="screen">
            <param name="left_state_topic" value="/robot/arm_left/joint_states_single" />
            <param name="right_state_topic" value="/robot/arm_right/joint_states_single" />
            <param name="left_cmd_topic" value="/robot/arm_left/joint_cmd_mux" />
            <param name="right_cmd_topic" value="/robot/arm_right/joint_cmd_mux" />
            <param name="duration_sec" value="$(arg auto_zero_duration_sec)" />
            <param name="rate" value="$(arg auto_zero_rate)" />
            <param name="wait_timeout_sec" value="$(arg auto_zero_wait_timeout_sec)" />
            <param name="settle_enable" value="$(arg auto_zero_settle_enable)" />
            <param name="settle_iters" value="$(arg auto_zero_settle_iters)" />
            <param name="settle_tol_rad" value="$(arg auto_zero_settle_tol_rad)" />
            <param name="settle_gain" value="$(arg auto_zero_settle_gain)" />
            <param name="settle_max_step_rad" value="$(arg auto_zero_settle_max_step_rad)" />
            <param name="settle_sample_sec" value="$(arg auto_zero_settle_sample_sec)" />
            <param name="settle_hold_sec" value="$(arg auto_zero_settle_hold_sec)" />
            <param name="settle_include_gripper" value="$(arg auto_zero_settle_include_gripper)" />
        </node>
    </group>

    <!-- Optional third robot slave arm (opp) -->
    <group if="$(arg enable_opp_slave)">
        <include file="$(find robot_setup)/launch/start_opp_slave.launch">
            <arg name="opp_can_port" value="$(arg opp_can_port)" />
            <arg name="opp_teleop_topic" value="$(arg opp_teleop_topic)" />
            <arg name="opp_robot_cmd_topic" value="$(arg opp_robot_cmd_topic)" />
            <arg name="opp_policy_topic" value="$(arg opp_policy_topic)" />
            <arg name="auto_enable" value="$(arg auto_enable)" />
            <arg name="gripper_cmd_limit_enable" value="$(arg opp_gripper_cmd_limit_enable)" />
            <arg name="gripper_cmd_deadband_raw" value="$(arg opp_gripper_cmd_deadband_raw)" />
        </include>
    </group>

    <group if="$(eval arg('enable_opp_slave') and arg('enable_opp_gaze'))">
        <node
            name="launch_opp_gaze_bridge"
            pkg="robot_setup"
            type="launch_opp_gaze_bridge.py"
            output="screen"
            args="--config $(arg opp_gaze_config) --python $(arg opp_gaze_python)" />
    </group>

    <!-- Launch camera slots. Canonical left/right/top names stay compatible with the existing pipeline. -->
    <group if="$(arg enable_cameras)">
        <group if="$(arg enable_camera_preflight_check)">
            <node
                name="realsense_preflight_check"
                pkg="robot_setup"
                type="realsense_preflight_check.py"
                output="screen"
                required="$(arg camera_preflight_strict)">
                <param name="strict" value="$(arg camera_preflight_strict)" />
                <param name="hold_node" value="$(arg camera_preflight_strict)" />
                <param name="check_video_device_occupancy" value="$(arg camera_preflight_check_video_occupancy)" />
                <param name="auto_cleanup_conflicts" value="$(arg camera_preflight_auto_cleanup_conflicts)" />
                <param name="auto_cleanup_wait_sec" value="$(arg camera_preflight_auto_cleanup_wait_sec)" />
                <param name="camera_names_csv" value="$(arg camera_left_name),$(arg camera_right_name),$(arg camera_top_name)" />
                <param name="camera_serials_csv" value="$(arg camera_left_serial_no),$(arg camera_right_serial_no),$(arg camera_top_serial_no)" />
            </node>
        </group>

        <include file="$(find robot_setup)/launch/camera_slot.launch">
            <arg name="enable" value="true" />
            <arg name="camera_name" value="$(arg camera_left_name)" />
            <arg name="camera_backend" value="$(arg camera_left_backend)" />
            <arg name="camera_serial_no" value="$(arg camera_left_serial_no)" />
            <arg name="camera_usb_port" value="$(arg camera_left_usb_port)" />
            <arg name="allow_auto_usb_fallback" value="$(arg camera_allow_auto_usb_fallback)" />
            <arg name="camera_frame_id" value="$(arg camera_left_frame_id)" />
            <arg name="realsense_launch_prefix" value="$(arg left_realsense_launch_prefix)" />
            <arg name="realsense_initial_reset" value="$(arg realsense_initial_reset)" />
            <arg name="realsense_log_level" value="$(arg realsense_log_level)" />
            <arg name="rs_color_width" value="$(arg camera_left_rs_color_width)" />
            <arg name="rs_color_height" value="$(arg camera_left_rs_color_height)" />
            <arg name="rs_color_fps" value="$(arg camera_left_rs_color_fps)" />
            <arg name="rs_enable_depth" value="$(arg camera_left_rs_enable_depth)" />
            <arg name="rs_enable_infra1" value="$(arg camera_left_rs_enable_infra1)" />
            <arg name="rs_enable_infra2" value="$(arg camera_left_rs_enable_infra2)" />
            <arg name="rs_enable_pointcloud" value="$(arg camera_left_rs_enable_pointcloud)" />
            <arg name="rs_align_depth" value="$(arg camera_left_rs_align_depth)" />
            <arg name="usb_video_device" value="$(arg camera_left_usb_video_device)" />
            <arg name="usb_image_width" value="$(arg camera_left_usb_image_width)" />
            <arg name="usb_image_height" value="$(arg camera_left_usb_image_height)" />
            <arg name="usb_fps" value="$(arg camera_left_usb_fps)" />
            <arg name="usb_pixel_format" value="$(arg camera_left_usb_pixel_format)" />
            <arg name="usb_driver_impl" value="$(arg camera_left_usb_driver_impl)" />
            <arg name="usb_color_format" value="$(arg camera_left_usb_color_format)" />
            <arg name="usb_io_method" value="$(arg camera_left_usb_io_method)" />
            <arg name="usb_jpeg_quality" value="$(arg camera_left_usb_jpeg_quality)" />
        </include>

        <include file="$(find robot_setup)/launch/camera_slot.launch">
            <arg name="enable" value="true" />
            <arg name="camera_name" value="$(arg camera_right_name)" />
            <arg name="camera_backend" value="$(arg camera_right_backend)" />
            <arg name="camera_serial_no" value="$(arg camera_right_serial_no)" />
            <arg name="camera_usb_port" value="$(arg camera_right_usb_port)" />
            <arg name="allow_auto_usb_fallback" value="$(arg camera_allow_auto_usb_fallback)" />
            <arg name="camera_frame_id" value="$(arg camera_right_frame_id)" />
            <arg name="realsense_launch_prefix" value="$(arg right_realsense_launch_prefix)" />
            <arg name="realsense_initial_reset" value="$(arg realsense_initial_reset)" />
            <arg name="realsense_log_level" value="$(arg realsense_log_level)" />
            <arg name="rs_color_width" value="$(arg camera_right_rs_color_width)" />
            <arg name="rs_color_height" value="$(arg camera_right_rs_color_height)" />
            <arg name="rs_color_fps" value="$(arg camera_right_rs_color_fps)" />
            <arg name="rs_enable_depth" value="$(arg camera_right_rs_enable_depth)" />
            <arg name="rs_enable_infra1" value="$(arg camera_right_rs_enable_infra1)" />
            <arg name="rs_enable_infra2" value="$(arg camera_right_rs_enable_infra2)" />
            <arg name="rs_enable_pointcloud" value="$(arg camera_right_rs_enable_pointcloud)" />
            <arg name="rs_align_depth" value="$(arg camera_right_rs_align_depth)" />
            <arg name="usb_video_device" value="$(arg camera_right_usb_video_device)" />
            <arg name="usb_image_width" value="$(arg camera_right_usb_image_width)" />
            <arg name="usb_image_height" value="$(arg camera_right_usb_image_height)" />
            <arg name="usb_fps" value="$(arg camera_right_usb_fps)" />
            <arg name="usb_pixel_format" value="$(arg camera_right_usb_pixel_format)" />
            <arg name="usb_driver_impl" value="$(arg camera_right_usb_driver_impl)" />
            <arg name="usb_color_format" value="$(arg camera_right_usb_color_format)" />
            <arg name="usb_io_method" value="$(arg camera_right_usb_io_method)" />
            <arg name="usb_jpeg_quality" value="$(arg camera_right_usb_jpeg_quality)" />
        </include>

        <include file="$(find robot_setup)/launch/camera_slot.launch">
            <arg name="enable" value="$(arg camera_top_enable)" />
            <arg name="camera_name" value="$(arg camera_top_name)" />
            <arg name="camera_backend" value="$(arg camera_top_backend)" />
            <arg name="camera_serial_no" value="$(arg camera_top_serial_no)" />
            <arg name="camera_usb_port" value="$(arg camera_top_usb_port)" />
            <arg name="usb_port_markers" value="$(arg usb_top_port_markers)" />
            <arg name="allow_auto_usb_fallback" value="$(arg camera_top_allow_auto_usb_fallback)" />
            <arg name="camera_frame_id" value="$(arg top_usb_frame_id)" />
            <arg name="realsense_launch_prefix" value="$(arg top_realsense_launch_prefix)" />
            <arg name="realsense_initial_reset" value="$(arg realsense_initial_reset)" />
            <arg name="realsense_log_level" value="$(arg realsense_log_level)" />
            <arg name="rs_color_width" value="$(arg camera_top_rs_color_width)" />
            <arg name="rs_color_height" value="$(arg camera_top_rs_color_height)" />
            <arg name="rs_color_fps" value="$(arg camera_top_rs_color_fps)" />
            <arg name="rs_enable_depth" value="$(arg camera_top_rs_enable_depth)" />
            <arg name="rs_enable_infra1" value="$(arg camera_top_rs_enable_infra1)" />
            <arg name="rs_enable_infra2" value="$(arg camera_top_rs_enable_infra2)" />
            <arg name="rs_enable_pointcloud" value="$(arg camera_top_rs_enable_pointcloud)" />
            <arg name="rs_align_depth" value="$(arg camera_top_rs_align_depth)" />
            <arg name="usb_video_device" value="$(arg top_usb_video_device)" />
            <arg name="usb_image_width" value="$(arg top_usb_image_width)" />
            <arg name="usb_image_height" value="$(arg top_usb_image_height)" />
            <arg name="usb_fps" value="$(arg top_usb_fps)" />
            <arg name="usb_pixel_format" value="$(arg top_usb_pixel_format)" />
            <arg name="usb_driver_impl" value="$(arg top_usb_driver_impl)" />
            <arg name="usb_color_format" value="$(arg top_usb_color_format)" />
            <arg name="usb_io_method" value="$(arg top_usb_io_method)" />
            <arg name="usb_jpeg_quality" value="$(arg top_usb_jpeg_quality)" />
            <arg name="usb_preconfigure_v4l2" value="$(arg top_usb_preconfigure_v4l2)" />
            <arg name="usb_configure_capture_properties" value="$(arg top_usb_configure_capture_properties)" />
            <arg name="usb_startup_open_delay_sec" value="$(arg top_usb_startup_open_delay_sec)" />
            <arg name="usb_enforce_actual_resolution" value="$(arg top_usb_enforce_actual_resolution)" />
            <arg name="usb_enforce_actual_pixel_format" value="$(arg top_usb_enforce_actual_pixel_format)" />
            <arg name="usb_startup_verify_frame_count" value="$(arg top_usb_startup_verify_frame_count)" />
            <arg name="usb_startup_min_read_fps_ratio" value="$(arg top_usb_startup_min_read_fps_ratio)" />
        </include>

        <include file="$(find robot_setup)/launch/camera_slot.launch">
            <arg name="enable" value="$(arg camera_extra_1_enable)" />
            <arg name="camera_name" value="$(arg camera_extra_1_name)" />
            <arg name="camera_backend" value="$(arg camera_extra_1_backend)" />
            <arg name="camera_serial_no" value="$(arg camera_extra_1_serial_no)" />
            <arg name="camera_usb_port" value="$(arg camera_extra_1_usb_port)" />
            <arg name="usb_port_markers" value="$(arg camera_extra_1_usb_port_markers)" />
            <arg name="allow_auto_usb_fallback" value="$(arg camera_extra_1_allow_auto_usb_fallback)" />
            <arg name="camera_frame_id" value="$(arg camera_extra_1_frame_id)" />
            <arg name="realsense_launch_prefix" value="$(arg camera_extra_1_realsense_launch_prefix)" />
            <arg name="realsense_initial_reset" value="$(arg realsense_initial_reset)" />
            <arg name="realsense_log_level" value="$(arg realsense_log_level)" />
            <arg name="rs_color_width" value="$(arg camera_extra_1_rs_color_width)" />
            <arg name="rs_color_height" value="$(arg camera_extra_1_rs_color_height)" />
            <arg name="rs_color_fps" value="$(arg camera_extra_1_rs_color_fps)" />
            <arg name="rs_enable_depth" value="$(arg camera_extra_1_rs_enable_depth)" />
            <arg name="rs_enable_infra1" value="$(arg camera_extra_1_rs_enable_infra1)" />
            <arg name="rs_enable_infra2" value="$(arg camera_extra_1_rs_enable_infra2)" />
            <arg name="rs_enable_pointcloud" value="$(arg camera_extra_1_rs_enable_pointcloud)" />
            <arg name="rs_align_depth" value="$(arg camera_extra_1_rs_align_depth)" />
            <arg name="usb_video_device" value="$(arg camera_extra_1_usb_video_device)" />
            <arg name="usb_image_width" value="$(arg camera_extra_1_usb_image_width)" />
            <arg name="usb_image_height" value="$(arg camera_extra_1_usb_image_height)" />
            <arg name="usb_fps" value="$(arg camera_extra_1_usb_fps)" />
            <arg name="usb_pixel_format" value="$(arg camera_extra_1_usb_pixel_format)" />
            <arg name="usb_io_method" value="$(arg camera_extra_1_usb_io_method)" />
            <arg name="usb_jpeg_quality" value="$(arg camera_extra_1_usb_jpeg_quality)" />
        </include>
    </group>
    
    <!-- FishEye stereo (hand cameras replacement) -->
    <group if="$(arg enable_fisheye)">
        <include file="$(find v4l2_cam_launch)/launch/fisheye_stereo.launch" />
    </group>

    <!-- 发布 handeye TF -->
    <group if="$(arg enable_handeye_tf)">
        <include file="$(find cam_calibration)/launch/publish.launch" />
    </group>

    <!-- Launch rviz -->
    <group if="$(arg enable_rviz)">
        <group if="$(arg use_default_rviz)">
            <group if="$(arg enable_fisheye)">
                <node name="rviz" pkg="rviz" type="rviz" args="-d $(find robot_setup)/rviz/dual_basic_fisheye.rviz" output="screen" />
            </group>
            <group unless="$(arg enable_fisheye)">
                <node
                    name="rviz"
                    pkg="robot_setup"
                    type="launch_dynamic_rviz.py"
                    args="--base-config $(find robot_setup)/rviz/dual_basic.rviz --enable-cameras $(arg enable_cameras) --camera-left-name $(arg camera_left_name) --camera-right-name $(arg camera_right_name) --camera-top-name $(arg camera_top_name) --camera-extra-1-enable $(arg camera_extra_1_enable) --camera-extra-1-name $(arg camera_extra_1_name) --rviz-image-transport $(arg rviz_image_transport)"
                    output="screen" />
            </group>
        </group>
        <group unless="$(arg use_default_rviz)">
            <include file="$(find piper_ctrl)/launch/piper_dual_robot_rviz.launch">
                <arg name="enable_default_tf" value="false" />
            </include>
        </group>
    </group>
</launch>
